# Copy to .env and fill in the values. Never commit .env.

# --- Docker Compose: PostgreSQL containers ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port for the dev database (default 5432)
POSTGRES_PORT=5432
# Test database (db_test service, Step E)
POSTGRES_TEST_DB=
POSTGRES_TEST_PORT=5433

# --- Backend application (backend/app/core/config.py) ---
# Must use the psycopg 3 driver and match the values above:
# postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=
# development | test | production
APP_ENV=development
