<?xml version="1.0" encoding="utf-8"?>
<!-- Pilot builds (#314): plain HTTP only to the local development server
     (emulator host, adb reverse, and this PC's Wi-Fi address). Every other
     host stays HTTPS-only. The hosted backend is named below so its
     HTTPS-only rule is explicit rather than implied by the default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">nutriguideai-77dx.onrender.com</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">172.17.175.48</domain>
    </domain-config>
</network-security-config>
