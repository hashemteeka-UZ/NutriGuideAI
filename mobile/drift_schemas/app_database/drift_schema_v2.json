  "fixed_sql": [
    {
      "name": "catalog_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_meta\" (\"lang\" TEXT NOT NULL, \"etag\" TEXT NOT NULL, \"dataset_version\" TEXT NOT NULL, \"meal_count\" INTEGER NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"lang\"));"
        }
      ]
    },
    {
      "name": "meals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meals\" (\"lang\" TEXT NOT NULL, \"meal_id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"search_key\" TEXT NOT NULL, \"cuisine\" TEXT NULL, \"dish_form\" TEXT NULL, \"serving_grams\" REAL NOT NULL, \"servings\" INTEGER NOT NULL, \"total_grams\" REAL NOT NULL, \"kcal\" REAL NOT NULL, \"protein_g\" REAL NOT NULL, \"carb_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"source\" TEXT NOT NULL, \"dataset_version\" TEXT NOT NULL, PRIMARY KEY (\"lang\", \"meal_id\"));"
        }
      ]
    },
    {
      "name": "meal_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_tags\" (\"lang\" TEXT NOT NULL, \"meal_id\" INTEGER NOT NULL, \"tag\" TEXT NOT NULL, PRIMARY KEY (\"lang\", \"meal_id\", \"tag\"), FOREIGN KEY(lang, meal_id) REFERENCES meals(lang, meal_id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "meal_allergens",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_allergens\" (\"lang\" TEXT NOT NULL, \"meal_id\" INTEGER NOT NULL, \"code\" TEXT NOT NULL, PRIMARY KEY (\"lang\", \"meal_id\", \"code\"), FOREIGN KEY(lang, meal_id) REFERENCES meals(lang, meal_id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "meal_ingredients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_ingredients\" (\"lang\" TEXT NOT NULL, \"meal_id\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"ingredient_id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"grams_per_serving\" REAL NOT NULL, \"is_optional\" INTEGER NOT NULL CHECK (\"is_optional\" IN (0, 1)), PRIMARY KEY (\"lang\", \"meal_id\", \"position\"), FOREIGN KEY(lang, meal_id) REFERENCES meals(lang, meal_id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "meal_nutrients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_nutrients\" (\"lang\" TEXT NOT NULL, \"meal_id\" INTEGER NOT NULL, \"code\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"per_100g\" REAL NULL, \"per_serving\" REAL NULL, PRIMARY KEY (\"lang\", \"meal_id\", \"code\"), FOREIGN KEY(lang, meal_id) REFERENCES meals(lang, meal_id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "meal_steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_steps\" (\"lang\" TEXT NOT NULL, \"meal_id\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"text\" TEXT NOT NULL, PRIMARY KEY (\"lang\", \"meal_id\", \"position\"), FOREIGN KEY(lang, meal_id) REFERENCES meals(lang, meal_id) ON DELETE CASCADE);"
        }
      ]
    },
