        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cuisines\" (\"lang\" TEXT NOT NULL, \"code\" TEXT NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"lang\", \"code\"));"
